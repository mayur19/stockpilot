# StockPilot local configuration. run.sh copies this to .env and replaces the
# placeholder secret with a random value. Never commit .env.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4103
WEB_PORT=5103
APP_ORIGIN=http://localhost:5103
# Native PostgreSQL over the local socket in /tmp as the current OS user (no password).
DATABASE_URL=postgresql://localhost:5432/stockpilot_dev?host=/tmp
TEST_DATABASE_URL=postgresql://localhost:5432/stockpilot_test?host=/tmp
DATABASE_POOL_MAX=10
SESSION_SECRET=replace-me-with-a-long-random-local-only-value
SESSION_TTL_HOURS=12
LOG_LEVEL=info
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Per-email progressive backoff starts after LOGIN_MAX_ATTEMPTS failures at this base delay.
LOGIN_BACKOFF_BASE_SECONDS=30
# Per-IP failure ceiling across all emails within the window (password-spraying guard).
LOGIN_IP_MAX_ATTEMPTS=50
REGISTER_IP_MAX_ATTEMPTS=10
# Reverse-proxy trust: false (default), a hop count (e.g. 1 behind nginx), or proxy IPs/CIDRs.
TRUST_PROXY=false
